{
	"_version": "1.21.0",

	"sap.app": {
		"id": "de.sovanta.ui5",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"dataSources": {
			"catalogService": {
				"uri": "/odata/v4/catalog/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			},
			"adminService": {
				"uri": "/odata/v4/admin/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		},
		"sourceTemplate": {
			"id": "generator-ui5-app",
			"version": "1.1.0"
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "de.sovanta.ui5.view.App",
			"type": "XML",
			"id": "app"
		},

		"dependencies": {
			"minUI5Version": "1.153.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.ui.layout": {}
			}
		},

		"handleValidation": true,

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"": {
				"dataSource": "catalogService",
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"admin": {
				"dataSource": "adminService",
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true
				}
			},
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "de.sovanta.ui5.i18n.i18n",
					"supportedLocales": ["en", "de"],
					"fallbackLocale": "en",
					"async": true
				}
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "de.sovanta.ui5.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "main",
					"target": "main"
				},
				{
					"pattern": "books/new",
					"name": "create",
					"target": "create"
				},
				{
					"pattern": "books/{bookId}",
					"name": "detail",
					"target": "detail"
				}
			],
			"targets": {
				"main": {
					"id": "main",
					"name": "Main"
				},
				"detail": {
					"id": "detail",
					"name": "Detail"
				},
				"create": {
					"id": "create",
					"name": "Create"
				}
			}
		}
	}
}
