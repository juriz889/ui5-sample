<mvc:View controllerName="de.sovanta.ui5.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="bookDetailPage"
        title="{i18n>detailTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        showFooter="{detailView>/editMode}"
        busyIndicatorDelay="0">
        <content>
            <ObjectHeader
                id="bookHeader"
                title="{title}"
                number="{price}"
                numberUnit="{currency/symbol}"
                responsive="true">
                <attributes>
                    <ObjectAttribute title="{i18n>colAuthor}" text="{author}" />
                    <ObjectAttribute title="{i18n>colGenre}" text="{genre/name}" />
                </attributes>
                <statuses>
                    <ObjectStatus
                        title="{i18n>colStock}"
                        text="{stock}"
                        state="{= ${stock} > 0 ? 'Success' : 'Error' }" />
                </statuses>
            </ObjectHeader>

            <Panel id="descrPanel" headerText="{i18n>detailDescription}" class="sapUiResponsiveMargin" width="auto"
                >
                <Text id="descrText" text="{descr}" />
            </Panel>

        </content>
    </Page>
</mvc:View>
