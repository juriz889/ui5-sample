<mvc:View
	controllerName="de.sovanta.ui5.controller.Create"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Page
		id="createPage"
		title="{i18n>createTitle}"
		showNavButton="true"
		navButtonPress=".onCancel">
		<content>
			<form:Form
				id="createForm"
				editable="true">
				<form:layout>
					<form:ColumnLayout columnsM="2" columnsL="3" columnsXL="4" />
				</form:layout>
				<form:formContainers>
					<form:FormContainer>
						<form:formElements>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colTitle}" required="true" labelFor="titleInput" />
								</form:label>
								<form:fields>
									<Input id="titleInput" value="{admin>title}" required="true" />
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colAuthor}" required="true" labelFor="authorInput" />
								</form:label>
								<form:fields>
									<ComboBox
										id="authorInput"
										required="true"
										selectedKey="{admin>author_ID}"
										items="{
											path: 'admin>/Authors',
											sorter: { path: 'name' },
											templateShareable: false
										}">
										<core:Item key="{admin>ID}" text="{admin>name}" />
									</ComboBox>
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colGenre}" labelFor="genreInput" />
								</form:label>
								<form:fields>
									<ComboBox
										id="genreInput"
										selectedKey="{admin>genre_ID}"
										items="{
											path: 'admin>/Genres',
											sorter: { path: 'name' },
											templateShareable: false
										}">
										<core:Item key="{admin>ID}" text="{admin>name}" />
									</ComboBox>
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colDescription}" labelFor="descrInput" />
								</form:label>
								<form:fields>
									<TextArea id="descrInput" value="{admin>descr}" rows="5" growing="true" />
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colStock}" labelFor="stockInput" />
								</form:label>
								<form:fields>
									<!-- value is bound in the controller, with the range from the service metadata -->
									<Input id="stockInput" />
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colPrice}" labelFor="priceInput" />
								</form:label>
								<form:fields>
									<Input id="priceInput" value="{admin>price}" />
								</form:fields>
							</form:FormElement>
							<form:FormElement>
								<form:label>
									<Label text="{i18n>colCurrency}" labelFor="currencyInput" />
								</form:label>
								<form:fields>
									<ComboBox
										id="currencyInput"
										selectedKey="{admin>currency_code}"
										items="{
											path: 'admin>/Currencies',
											sorter: { path: 'code' },
											templateShareable: false
										}">
										<core:Item key="{admin>code}" text="{admin>code} ({admin>symbol})" />
									</ComboBox>
			
								</form:fields>
							</form:FormElement>
						</form:formElements>
					</form:FormContainer>
				</form:formContainers>
			</form:Form>
		</content>
		<dependents>
			<MessagePopover
				id="messagePopover"
				items="{message>/}"
				activeTitlePress=".onMessageActiveTitlePress">
				<MessageItem
					type="{message>type}"
					title="{message>message}"
					subtitle="{message>additionalText}"
					description="{message>description}"
					activeTitle="{= ${message>controlIds}.length > 0 }" />
			</MessagePopover>
		</dependents>
		<footer>
			<OverflowToolbar>
				<Button
					id="messageButton"
					type="Negative"
					icon="sap-icon://message-popup"
					text="{= ${message>/}.length }"
					tooltip="{i18n>messagesButton}"
					visible="{= ${message>/}.length > 0 }"
					press=".onMessageButtonPress" />
				<ToolbarSpacer />
				<Button
					id="saveButton"
					text="{i18n>saveButton}"
					type="Emphasized"
					press=".onSave" />
				<Button
					id="cancelButton"
					text="{i18n>cancelButton}"
					press=".onCancel" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
